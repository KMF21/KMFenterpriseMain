//Navbar search
   <li className="nav-item search-right">
                  <Link
                    href="#search"
                    className="btn search-btn"
                    title="search"
                  >
                    <span className="fas fa-search me-2" aria-hidden="true" />
                  </Link>
                  {/* search popup */}
                  <div id="search" className="pop-overlay">
                    <div className="popup">
                      <h3 className="title-w3l two mb-4 text-left">
                        Search Here
                      </h3>
                      <form
                        action="#"
                        method="GET"
                        className="search-box d-flex position-relative"
                      >
                        <input
                          type="search"
                          placeholder="Enter Keyword here"
                          name="search"
                          required
                          autoFocus
                          onInput={handleInput}
                          value={focusText}
                        />
                        <button type="submit" className="btn">
                          <span className="fas fa-search" aria-hidden="true" />
                        </button>
                      </form>
                    </div>
                    <Link className="close" href="#close">
                      ×
                    </Link>
                  </div>
                  {/* /search popup */}
                </li>